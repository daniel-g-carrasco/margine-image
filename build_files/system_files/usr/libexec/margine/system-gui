#!/usr/bin/python3
# Margine System — the graphical answer to "is my machine current and healthy?"
#
# Everything here already existed as CLI (margine-status, ujust
# margine-update, ujust margine-doctor, rpm-ostree rollback). This app
# is not a reimplementation: it drives the same scripts, so there is
# exactly one definition of "how Margine updates" and the GUI can never
# drift from the terminal (system-update is the shared helper; the just
# recipe calls it too).
#
# Privilege model: the app runs as the user and never asks for a
# password on its own. Privileged actions (stage an update, roll back)
# go through pkexec, which DOES have an authentication agent in a
# graphical session — unlike uupd's system-service context, where the
# same call is refused silently (the bug that left brew months behind,
# see brew-upgrade).
#
# Read-only state comes from unprivileged sources on purpose:
# `rpm-ostree status --json` for the local deployments (bootc status
# requires root), skopeo for the published :stable, and the
# margine-validate-* scripts, which are all user-runnable by design.

import json
import os
import shutil
import subprocess

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "dev.margine.System"
IMAGE = "ghcr.io/daniel-g-carrasco/margine:stable"
SYSTEM_UPDATE = "/usr/libexec/margine/system-update"
BREW = "/home/linuxbrew/.linuxbrew/bin/brew"


def run(argv, timeout=30):
    """Best-effort command runner: returns stdout or '' — the UI shows
    'unknown' rather than crashing when a tool is missing."""
    try:
        res = subprocess.run(argv, text=True, capture_output=True, timeout=timeout)
        return res.stdout if res.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def local_state():
    """Booted / staged / rollback deployments from rpm-ostree."""
    out = run(["rpm-ostree", "status", "--json"])
    state = {"booted": None, "staged": None, "rollback": None, "layered": [],
             "booted_digest": "", "staged_digest": ""}
    if not out:
        return state
    try:
        deployments = json.loads(out).get("deployments", [])
    except json.JSONDecodeError:
        return state
    seen_booted = False
    for dep in deployments:
        version = dep.get("version") or (dep.get("checksum") or "")[:12]
        # The manifest digest is the only identity that survives two builds
        # published under the same version label (both stable builds of
        # 2026-08-30 were candidate.20260830): margine-status already judges
        # by digest, this GUI said "Up to Date" on the older one.
        digest = (dep.get("base-commit-meta") or {}).get("ostree.manifest-digest") or ""
        if dep.get("staged"):
            state["staged"] = version
            state["staged_digest"] = digest
        elif dep.get("booted"):
            state["booted"] = version
            state["booted_digest"] = digest
            seen_booted = True
            state["layered"] = sorted(
                set(dep.get("requested-packages") or []) | set(dep.get("packages") or [])
            )
        elif seen_booted and state["rollback"] is None:
            state["rollback"] = version
    return state


