#!/usr/bin/sh
# Lucciola: start Noctalia with the image's defaults.
#
# Noctalia has no system-wide configuration layer: it merges every *.toml in
# ~/.config/noctalia/ in alphabetical order. So each user gets, once, a small
# 00-lucciola.toml that includes the defaults kept in /usr/share (updated with
# every image); the user's own files sort after it and win. It is created only
# the first time: delete it and it stays deleted.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
marker="${XDG_STATE_HOME:-$HOME/.local/state}/lucciola/noctalia-seeded"
if [ ! -e "$marker" ]; then
  mkdir -p "$cfg" "$(dirname "$marker")"
  if [ ! -e "$cfg/00-lucciola.toml" ]; then
    cat > "$cfg/00-lucciola.toml" <<'TOML'
# Lucciola defaults (from the system image). Your own files in this folder
# sort after this one and win. Delete this file to use Noctalia's defaults.
[include]
files = ["/usr/share/lucciola/noctalia/"]
TOML
  fi
  : > "$marker"
fi
# The Margine palette must sit in the user's palettes/ folder (Noctalia looks
# nowhere else): a link to the image's copy, so it follows image updates.
# Only created when missing; a user's own file of that name is left alone.
pal="$cfg/palettes/Margine.json"
if [ ! -e "$pal" ] && [ ! -L "$pal" ]; then
  mkdir -p "$cfg/palettes"
  ln -s /usr/share/lucciola/noctalia/palettes/Margine.json "$pal"
fi
# Bar widths for large monitors, before Noctalia reads its config.
/usr/libexec/lucciola/bar-widths --once || true
exec noctalia
