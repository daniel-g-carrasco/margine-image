#!/usr/bin/env bash
# Bring up an external monitor that a USB-C dock failed to announce.
#
# THE BUG THIS WORKS AROUND
#
# On the Framework Laptop 13 (AMD Ryzen 7040), plugging in a USB-C dock
# while the system is running often brings up everything except the
# screen. The dock's USB side enumerates perfectly: mouse, keyboard,
# hubs, ethernet. DisplayPort Alt Mode is simply never entered, so the
# cable's lanes stay assigned to USB and there is no video signal at all.
#
# Measured on the reference host, 2026-08-25, with the screen dark:
#
#   USB side               all dock devices present
#   DP connectors          none "connected"
#   forcing a GPU re-probe no change, kernel logs nothing
#   kernel log             ucsi_acpi USBC000:00: UCSI_GET_PDOS failed (-5)
#
# That last line is the tell. This is not the GPU and not the desktop:
# nothing downstream can find a signal that was never negotiated. The
# machine's UCSI implementation (the firmware interface that runs USB-C
# port negotiation) botches the alt-mode entry, and it is a known weak
# spot on this hardware.
#
# WHAT FIXES IT
#
# Re-binding the ucsi_acpi driver makes the connector state be read from
# scratch, and the dock enters DisplayPort on the second attempt. Also
# measured: the screen came up immediately, and the cost is the dock's
# USB devices dropping and returning within about one second.
#
# A data role swap was tried first and the port refuses it, so it is not
# in here.
#
# WHEN IT FIRES
#
# The first version of this gated on the laptop model, which was honest
# but poor: it helped one machine and left every other one to find the
# manual command. The gate now asks the dock instead, which turns out to
# report exactly what we need to know. See billboard_reports_failure().
#
# That distinction matters for the false positive worth avoiding: a dock
# with no monitor plugged into it. There the negotiation succeeds and
# there is simply nothing to show, the billboard says so, and we stay
# quiet. Blinking every dock device for a second in that case would be a
# regression for anyone using a dock as a plain hub.
#
# The model list survives as a fallback for docks that expose no usable
# billboard descriptor.
set -uo pipefail

DMI_VENDOR=/sys/class/dmi/id/sys_vendor
DMI_PRODUCT=/sys/class/dmi/id/product_name
UCSI_DRV=/sys/bus/platform/drivers/ucsi_acpi
STAMP=/run/margine-dock-dp-rescue.stamp
# One rescue per minute. Rebinding re-creates the very typec devices
# whose appearance triggers this script, so without a rate limit a dock
# that never negotiates DisplayPort would have us rebinding forever.
COOLDOWN=60
# Long enough for the normal path to win on its own. When alt mode is
# entered correctly the connector shows up well inside this window, and
# the script then does nothing at all.
GRACE=6

FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

log() {
  logger -t margine-dock-dp-rescue -- "$*"
  (( FORCE )) && echo "$*"
}

# --force is how `ujust margine-dock-wake` gets here: someone asking for
# the rescue by hand, on any machine. It skips every gate and the grace
# period, because a person typing a command has already decided.

dp_connected() {
  local f
  for f in /sys/class/drm/card*-DP-*/status; do
    # Exact match: "disconnected" contains "connected", and a substring
    # test here would report every dark port as a working one.
    [ "$(cat "$f" 2>/dev/null)" = "connected" ] && return 0
  done
  return 1
}

typec_partner_present() {
  local p
  for p in /sys/class/typec/port[0-9]-partner; do
    [ -e "$p" ] && return 0
  done
  return 1
}

# Ask the dock whether DisplayPort actually failed, instead of inferring
# it from the laptop model.
#
# A USB-C device with alternate modes exposes a Billboard descriptor, and
# in it a two-bit state per mode: 00 error, 01 not attempted, 10 attempted
# and unsuccessful, 11 successful. Measured on the reference host on
# 2026-08-25, same dock, two plug-ins minutes apart:
#
#   screen up    bmConfigured 03   "Alternate Mode configuration successful"
#   screen dark  bmConfigured 01   "Alternate Mode configuration not attempted"
#
# So it is live, per enumeration, and it tells the truth. That makes it a
# far better gate than a list of laptop models: it fires on the machine
# that has the problem, whoever made it, and it stays quiet on a dock
# that entered DisplayPort fine and simply has no monitor plugged into
# it, which is the false positive worth avoiding.
#
# Parsed out of lsusb because the kernel exposes no sysfs path for BOS
# descriptors. If usbutils is missing or its wording changes, this
# returns "no opinion" and the model list below decides instead.
billboard_reports_failure() {
  command -v lsusb >/dev/null 2>&1 || return 1
  local d i vid pid modes
  for d in /sys/bus/usb/devices/*/; do
    for i in "$d"*/bInterfaceClass; do
      [ -f "$i" ] || continue
      [ "$(cat "$i" 2>/dev/null)" = "11" ] || continue
      vid=$(cat "$d/idVendor" 2>/dev/null); pid=$(cat "$d/idProduct" 2>/dev/null)
      modes=$(lsusb -v -d "$vid:$pid" 2>/dev/null | grep -iE "^ *Alternate Mode [0-9]+ *:")
      [ -n "$modes" ] || continue
      # At least one advertised mode is not reported as successful.
      if grep -qiv "configuration successful" <<<"$modes"; then
        log "billboard on $vid:$pid reports a mode that did not configure"
        return 0
      fi
      log "billboard on $vid:$pid reports every mode configured, leaving it alone"
      return 1
    done
  done
  return 1
}

model_is_known_broken() {
  case "$(cat "$DMI_VENDOR" 2>/dev/null)/$(cat "$DMI_PRODUCT" 2>/dev/null)" in
    # Evidence: see the header of this file.
    "Framework/Laptop 13 (AMD Ryzen 7040Series)") return 0 ;;
  esac
  return 1
}

(( FORCE )) || sleep "$GRACE"

# Nothing to rescue: either the screen arrived on its own, or the dock is
# gone again, or there is no dock at all.
if dp_connected; then
  log "a DisplayPort output is already connected, nothing to rescue"
  exit 0
fi
if ! typec_partner_present; then
  log "no USB-C device attached, nothing to rescue"
  exit 0
fi

# The decision, in order of how much it knows: what the dock says about
# its own negotiation first, the model list only as a fallback for docks
# that expose no usable billboard.
if (( ! FORCE )); then
  if billboard_reports_failure; then
    :
  elif model_is_known_broken; then
    log "no billboard verdict, but this model is known to miss DisplayPort"
  else
    exit 0
  fi
fi

if (( ! FORCE )) && [ -f "$STAMP" ]; then
  now=$(date +%s)
  then=$(cat "$STAMP" 2>/dev/null || echo 0)
  if (( now - then < COOLDOWN )); then
    log "skipped: rescued $((now - then))s ago, inside the ${COOLDOWN}s cooldown"
    exit 0
  fi
fi
date +%s > "$STAMP"

[ -w "$UCSI_DRV/unbind" ] || { log "ucsi_acpi driver not bindable, giving up"; exit 0; }

dev=$(basename "$(readlink -f /sys/bus/platform/drivers/ucsi_acpi/USBC*)" 2>/dev/null)
[ -n "$dev" ] || dev=USBC000:00

log "no DisplayPort after ${GRACE}s with a dock attached, re-initialising ucsi_acpi ($dev)"
echo "$dev" > "$UCSI_DRV/unbind" 2>/dev/null || { log "unbind failed"; exit 0; }
sleep 2
echo "$dev" > "$UCSI_DRV/bind" 2>/dev/null || { log "bind failed, the port is now unmanaged until replug"; exit 1; }
sleep 5

if dp_connected; then
  log "display came up after re-initialising the controller"
else
  log "display still absent; the dock may simply have no monitor attached"
fi
