# https://fedoraproject.org/wiki/Changes/Third_Party_Software_Mechanism
enable fedora-third-party-refresh.service

# https://fedoraproject.org/wiki/Changes/AutomaticBootloaderUpdatesBootc
enable bootloader-update.service

# See: https://gitlab.com/fedora/ostree/sig/-/work_items/103
enable fedora-atomic-desktop-appstream-cache-refresh.service

# See: https://gitlab.com/fedora/ostree/sig/-/work_items/62
enable fedora-atomic-desktop-mandb-update.service
