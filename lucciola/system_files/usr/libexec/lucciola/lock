#!/usr/bin/sh
# Lucciola: lock the session with Noctalia's lock screen.
#
# Bound to Mod+Ctrl+L with allow-when-locked=true, so it also works from the
# red screen niri shows when a lock screen dies while the session is locked:
# start Noctalia again if it is gone, then ask it to lock.
if ! pgrep -x noctalia >/dev/null 2>&1; then
  noctalia >/dev/null 2>&1 &
  i=0
  while [ "$i" -lt 50 ] && ! noctalia msg status >/dev/null 2>&1; do
    sleep 0.1
    i=$((i + 1))
  done
fi
exec noctalia msg session lock
