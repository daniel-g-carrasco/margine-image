#!/usr/bin/python3
"""Lucciola: per-monitor bar layout for Noctalia.

1. Fixed bar width on large screens. Noctalia sizes the bar with margins
   from the screen ends (margin_ends), not with a width, so the same margins
   that look right on a laptop stretch the bar across a large monitor. For
   every output wider than WIDE_ABOVE logical pixels the bar is kept
   BAR_WIDTH wide, centred.
2. One workspace on secondary screens, as in GNOME. The primary screen is
   the one holding the named workspace "1"; with more than one screen, the
   others get a bar without the workspace indicator (the Super+1..5
   workspaces live on the primary). Unplug the primary and its workspaces
   move to the remaining screen, which becomes primary again.

The overrides go to Noctalia's config folder (30-lucciola-monitors.toml),
and Noctalia is asked to reload when they change. niri announces no monitor
events, but plugging or unplugging a monitor always changes the workspaces,
so everything is recomputed on every WorkspacesChanged event.

  bar-widths --once   write the overrides and exit (before Noctalia starts)
  bar-widths          write them, then follow monitor changes
"""
import json
import os
import subprocess
import sys

BAR_WIDTH = 1240     # logical px: the bar on a 1440-wide laptop screen
WIDE_ABOVE = 1600    # screens up to this width keep the default margins

CONFIG = os.path.join(
    os.environ.get("NOCTALIA_CONFIG_HOME") or os.environ.get("XDG_CONFIG_HOME")
    or os.path.expanduser("~/.config"),
    "noctalia",
)
TARGET = os.path.join(CONFIG, "30-lucciola-monitors.toml")
SECONDARY_START = ["active_window"]   # bar start section without workspaces
HEADER = (
    "# Generated by /usr/libexec/lucciola/bar-widths: the bar stays "
    f"{BAR_WIDTH}px wide on screens wider than {WIDE_ABOVE}px, and screens\n"
    "# other than the one holding workspace \"1\" show no workspace indicator.\n"
    "# Rewritten whenever monitors change; do not edit (put your own bar "
    "settings in another file).\n"
)


def niri_json(what):
    try:
        out = subprocess.run(["niri", "msg", "-j", what], capture_output=True,
                             text=True, timeout=5, check=True).stdout
        return json.loads(out)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def outputs():
    return niri_json("outputs")


def primary_output():
    for ws in niri_json("workspaces") or []:
        if ws.get("name") == "1":
            return ws.get("output")
    return None


def render(outs, primary):
    lines = [HEADER]
    for name in sorted(outs):
        logical = (outs[name] or {}).get("logical") or {}
        width = logical.get("width") or 0
        settings = []
        if width > WIDE_ABOVE:
            settings.append(f"margin_ends = {max(0, (width - BAR_WIDTH) // 2)}")
        if len(outs) > 1 and primary and name != primary:
            settings.append("start = " + json.dumps(SECONDARY_START))
        if not settings:
            continue
        key = "".join(c if c.isalnum() else "_" for c in name).lower()
        lines.append(f'\n[bar.default.monitor.lucciola_{key}]\nmatch = "{name}"\n'
                     + "".join(line + "\n" for line in settings))
    return "".join(lines)


def write(outs, primary):
    text = render(outs, primary)
    try:
        with open(TARGET) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    os.makedirs(CONFIG, exist_ok=True)
    tmp = TARGET + ".new"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, TARGET)
    return True


def signature(outs, primary):
    return (primary, sorted((n, ((o or {}).get("logical") or {}).get("width")) for n, o in outs.items()))


def reload_noctalia():
    subprocess.run(["noctalia", "msg", "config-reload"], capture_output=True, timeout=5)


def main():
    outs = outputs()
    primary = primary_output()
    if outs is not None:
        write(outs, primary)
    if "--once" in sys.argv[1:]:
        return
    last = signature(outs, primary) if outs else None
    stream = subprocess.Popen(["niri", "msg", "-j", "event-stream"],
                              stdout=subprocess.PIPE, text=True)
    for line in stream.stdout:
        if '"WorkspacesChanged"' not in line:
            continue
        outs = outputs()
        if outs is None:
            continue
        primary = primary_output()
        current = signature(outs, primary)
        if current == last:
            continue
        last = current
        if write(outs, primary):
            reload_noctalia()


if __name__ == "__main__":
    main()
