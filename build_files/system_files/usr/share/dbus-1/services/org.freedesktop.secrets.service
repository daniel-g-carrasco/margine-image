# Margine (Fedora 45): oo7 ships no D-Bus activation file for the Secret
# Service; only GNOME's session target starts oo7-daemon. gnome-keyring had
# one, so on Fedora 44 the first app asking for a secret started the
# service in any session. This keeps that: Lucciola's niri session, and an
# app that asks before GNOME's target got to it, find the service.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/bin/false
SystemdService=dbus-org.freedesktop.secrets.service
