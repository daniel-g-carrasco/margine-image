#!/usr/bin/python3
"""Lucciola: keep Noctalia's bar at a fixed width on large screens.

Noctalia sizes the bar with margins from the screen ends (margin_ends), not
with a width, so the same margins that look right on a laptop stretch the
bar across a large external monitor. For every connected output wider than
WIDE_ABOVE logical pixels this writes a per-monitor override that leaves the
bar BAR_WIDTH wide, centred, into Noctalia's config folder, and asks Noctalia
to reload when the overrides change.

niri announces no monitor events, but connecting or disconnecting a monitor
always changes the workspaces, so the outputs are re-read on every
WorkspacesChanged event.

  bar-widths --once   write the overrides and exit (before Noctalia starts)
  bar-widths          write them, then follow monitor changes
"""
import json
import os
import subprocess
import sys

BAR_WIDTH = 1240     # logical px: the bar on a 1440-wide laptop screen
WIDE_ABOVE = 1600    # screens up to this width keep the default margins

CONFIG = os.path.join(
    os.environ.get("NOCTALIA_CONFIG_HOME") or os.environ.get("XDG_CONFIG_HOME")
    or os.path.expanduser("~/.config"),
    "noctalia",
)
TARGET = os.path.join(CONFIG, "30-lucciola-monitors.toml")
HEADER = (
    "# Generated by /usr/libexec/lucciola/bar-widths: the bar stays "
    f"{BAR_WIDTH}px wide on screens wider than {WIDE_ABOVE}px.\n"
    "# Rewritten whenever monitors change; do not edit (put your own bar "
    "settings in another file).\n"
)


def outputs():
    try:
        out = subprocess.run(["niri", "msg", "-j", "outputs"], capture_output=True,
                             text=True, timeout=5, check=True).stdout
        return json.loads(out)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def render(outs):
    lines = [HEADER]
    for name in sorted(outs):
        logical = (outs[name] or {}).get("logical") or {}
        width = logical.get("width") or 0
        if width <= WIDE_ABOVE:
            continue
        key = "".join(c if c.isalnum() else "_" for c in name).lower()
        lines.append(f'\n[bar.default.monitor.lucciola_{key}]\n'
                     f'match = "{name}"\n'
                     f'margin_ends = {max(0, (width - BAR_WIDTH) // 2)}\n')
    return "".join(lines)


def write(outs):
    text = render(outs)
    try:
        with open(TARGET) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    os.makedirs(CONFIG, exist_ok=True)
    tmp = TARGET + ".new"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, TARGET)
    return True


def signature(outs):
    return sorted((n, ((o or {}).get("logical") or {}).get("width")) for n, o in outs.items())


def reload_noctalia():
    subprocess.run(["noctalia", "msg", "config-reload"], capture_output=True, timeout=5)


def main():
    outs = outputs()
    if outs is not None:
        write(outs)
    if "--once" in sys.argv[1:]:
        return
    last = signature(outs) if outs else None
    stream = subprocess.Popen(["niri", "msg", "-j", "event-stream"],
                              stdout=subprocess.PIPE, text=True)
    for line in stream.stdout:
        if '"WorkspacesChanged"' not in line:
            continue
        outs = outputs()
        if outs is None:
            continue
        current = signature(outs)
        if current == last:
            continue
        last = current
        if write(outs):
            reload_noctalia()


if __name__ == "__main__":
    main()
