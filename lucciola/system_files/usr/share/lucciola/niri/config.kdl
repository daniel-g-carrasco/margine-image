// Lucciola: the niri configuration shipped with the image.
//
// /etc/niri/config.kdl includes this file and then, if it exists,
// ~/.config/niri/lucciola.kdl: put personal settings there, they win.
// niri reads /etc/niri/config.kdl only while ~/.config/niri/config.kdl does
// not exist; a full personal config.kdl replaces all of this.
//
// Keybindings follow Margine's GNOME ones (declarations/margine-atomic.yaml,
// gnome.keybindings), so the hands do not have to relearn: Mod is Super.
// Mod+Shift+H shows the full list.

input {
    keyboard {
        xkb {
            // Empty on purpose: niri then takes the layout configured on the
            // system (systemd-localed), the same one GNOME uses.
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    // Margine's o-tiling moved the pointer to the focused window.
    warp-mouse-to-focus
}

layout {
    // The look of the first Margine (Hyprland): small gaps, a cream border on
    // the focused window, a dark one on the others.
    gaps 6
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 3
        active-color "#eae7dbe0"
        inactive-color "#423a3ecc"
        urgent-color "#ff938c"
    }

    shadow {
        on
        softness 24
        spread 4
        offset x=0 y=4
        color "#1a1a1ab8"
    }
}

// Five workspaces that always exist, as in Margine (Mod+1 ... Mod+5).
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"

// Noctalia is the shell: bar, notifications, lock screen, launcher, OSD,
// polkit agent, clipboard, night light, wallpaper. The wrapper seeds the
// Lucciola defaults for Noctalia once per user, then starts it.
spawn-at-startup "/usr/libexec/lucciola/session-start"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Rounded corners: GTK/libadwaita windows draw their own rounded corners,
// so a square border leaves a gap at each corner.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Noctalia's settings window floats.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    open-floating true
}

// Noctalia's blurred wallpaper copy behind the overview.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

debug {
    // Lets Noctalia's notification actions raise the window they belong to.
    honor-xdg-activation-with-invalid-serial
}

binds {
    // Super+Shift+H: on Italian keyboards "/" is Shift+7, so the upstream
    // Super+Shift+/ is awkward; both work.
    Mod+Shift+H hotkey-overlay-title="Elenco delle scorciatoie" { show-hotkey-overlay; }
    Mod+Shift+Slash hotkey-overlay-title=null { show-hotkey-overlay; }

    // Applications (same keys as Margine)
    Mod+Return hotkey-overlay-title="Terminale" { spawn "ptyxis"; }
    Mod+Shift+Return hotkey-overlay-title="Browser" { spawn "flatpak" "run" "app.zen_browser.zen"; }
    Mod+E hotkey-overlay-title="File" { spawn "nautilus" "--new-window"; }
    Mod+Ctrl+T hotkey-overlay-title="Monitor di sistema" { spawn "ptyxis" "--" "btop"; }
    Mod+Period hotkey-overlay-title="Emoji" { spawn "flatpak" "run" "it.mijorus.smile"; }

    // Shell (Noctalia)
    Mod+Space hotkey-overlay-title="Applicazioni" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+R hotkey-overlay-title=null { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+N hotkey-overlay-title="Centro di controllo e notifiche" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+V hotkey-overlay-title="Cronologia appunti" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Comma hotkey-overlay-title="Impostazioni della shell" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Escape hotkey-overlay-title="Esci, riavvia, spegni" { spawn-sh "noctalia msg panel-toggle session"; }
    Alt+Tab hotkey-overlay-title="Cambia finestra" { spawn-sh "noctalia msg window-switcher hold"; }

    // Lock. Allowed while locked on purpose: if the lock screen ever dies,
    // niri keeps the session locked on a red screen, and this key brings a
    // fresh lock screen back (see /usr/libexec/lucciola/lock).
    Mod+Ctrl+L allow-when-locked=true hotkey-overlay-title="Blocca lo schermo" { spawn "/usr/libexec/lucciola/lock"; }

    Mod+Shift+Space repeat=false hotkey-overlay-title="Panoramica" { toggle-overview; }

    // Windows
    Mod+W repeat=false hotkey-overlay-title="Chiudi la finestra" { close-window; }
    Mod+F hotkey-overlay-title="Schermo intero" { fullscreen-window; }
    Mod+M hotkey-overlay-title="Massimizza la colonna" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Finestra fluttuante" { toggle-window-floating; }
    Mod+Shift+S { toggle-column-tabbed-display; }
    Mod+C { center-column; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Left  { move-column-left; }
    Mod+Right { move-column-right; }
    Mod+Up    { move-window-up; }
    Mod+Down  { move-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Ctrl+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Monitors
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // Screenshots (same keys as Margine)
    Print hotkey-overlay-title="Screenshot" { screenshot; }
    Mod+Shift+P { screenshot; }
    Ctrl+Print { screenshot-window; }
    Mod+Shift+W { screenshot-window; }
    Shift+Print { spawn "flatpak" "run" "be.alexandervanhee.gradia" "--screenshot=INTERACTIVE"; }
    Mod+Shift+A { spawn "flatpak" "run" "be.alexandervanhee.gradia" "--screenshot=INTERACTIVE"; }

    // Media and brightness keys, also on the lock screen
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Session
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E hotkey-overlay-title="Esci da Lucciola" { quit; }
    Ctrl+Alt+Delete { quit; }
}
