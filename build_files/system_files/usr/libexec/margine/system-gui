    # ── small helpers ────────────────────────────────────────────────

    def _info_row(self, group, title, icon):
        row = Adw.ActionRow(title=title, subtitle="…")
        row.add_prefix(Gtk.Image.new_from_icon_name(icon))
        row.set_activatable(False)
        group.add(row)
        return row

    def _toast(self, message):
        self._toasts.add_toast(Adw.Toast.new(message))

    # ── state refresh ────────────────────────────────────────────────

    def _refresh(self):
        self._state = local_state()
        booted = self._state.get("booted") or "unknown"
        self._version_row.set_subtitle(booted)
        self._kernel_row.set_subtitle(os.uname().release)

        self._base_row.set_subtitle("Fedora → Bluefin DX → Margine")

        layered = self._state.get("layered") or []
        if layered:
            preview = ", ".join(layered[:3])
            if len(layered) > 3:
                preview += f" and {len(layered) - 3} more"
            self._layered_row.set_subtitle(
                f"{preview} — refreshed with every system update"
            )
            self._layered_row.set_activatable(True)
        else:
            self._layered_row.set_subtitle("None: this is a stock Margine system")
            self._layered_row.set_activatable(False)

        self._update_banner()
        self._refresh_counts_async()
        self._refresh_latest_async()

        rollback = self._state.get("rollback")
        if rollback:
            self._rollback_row.set_subtitle(f"Restart into {rollback}")
            self._rollback_button.set_sensitive(not self._busy)
        else:
            self._rollback_row.set_subtitle("No previous version on this machine yet")
            self._rollback_button.set_sensitive(False)

    def _update_banner(self):
        staged = self._state.get("staged")
        booted = self._state.get("booted") or "unknown"
        self._hero_version.set_text(staged or booted)

        if staged:
            self._hero_icon.set_from_icon_name("system-reboot-symbolic")
            self._hero_icon.remove_css_class("accent")
            self._hero_icon.add_css_class("accent")
            self._hero_title.set_text("Restart to Finish")
            self._hero_body.set_text(
                f"This version is downloaded and waiting. You are running {booted} until you restart."
            )
            self._set_action("Restart Now", suggested=True)
            return

        if self._latest is None:
            self._hero_icon.set_from_icon_name("content-loading-symbolic")
            self._hero_title.set_text("Checking for Updates")
            self._hero_body.set_text("Asking the server which version is published…")
            self._action_button.set_visible(False)
            return

        booted_digest = self._state.get("booted_digest") or ""
        latest_digest = getattr(self, "_latest_digest", "") or ""
        if booted_digest and latest_digest:
            # Same identity check margine-status uses: digests, not labels.
            if booted_digest != latest_digest:
                self._hero_icon.set_from_icon_name("software-update-available-symbolic")
                self._hero_title.set_text("Update Available")
                if booted == self._latest:
                    self._hero_body.set_text(
                        f"A newer build of {self._latest} is published. Two builds can share "
                        "a version label on the same day; this machine runs the older one."
                    )
                else:
                    self._hero_body.set_text(
                        f"You are on {booted}. The published version is {self._latest}."
                    )
                self._set_action("Download Update", suggested=True)
                return
        elif self._latest and booted != self._latest:
            self._hero_icon.set_from_icon_name("software-update-available-symbolic")
            self._hero_title.set_text("Update Available")
            self._hero_body.set_text(f"You are on {booted}. The published version is {self._latest}.")
            self._set_action("Download Update", suggested=True)
            return

        self._hero_icon.set_from_icon_name("object-select-symbolic")
        self._hero_title.set_text("Up to Date")
        self._hero_body.set_text("This machine matches the latest published version.")
        self._set_action("Check Again", suggested=False)

    def _set_action(self, label, suggested):
        self._action_button.set_label(label)
        self._action_button.remove_css_class("suggested-action")
        if suggested:
            self._action_button.add_css_class("suggested-action")
        self._action_button.set_visible(True)

    def _refresh_latest_async(self):
        def worker():
            out = run(
                [
                    "skopeo", "inspect", "--no-tags", f"docker://{IMAGE}",
                    "--format",
                    "{{.Digest}} {{ index .Labels \"org.opencontainers.image.version\" }}",
                ],
                timeout=60,
            ).strip()
            digest, _, version = out.partition(" ")
            if not version:
                digest, version = "", out
            GLib.idle_add(self._set_latest, version or None, digest or "")

        GLib.Thread.new(None, worker)

    def _set_latest(self, latest, latest_digest=""):
        self._latest = latest
        self._latest_digest = latest_digest
        self._update_banner()
        return False

    def _refresh_counts_async(self):
        def worker():
            flatpak = run(["flatpak", "remote-ls", "--updates", "--columns=application"], 90)
            flat_list = [line.strip() for line in flatpak.splitlines() if line.strip()]
            brew_list = None  # None = unavailable, [] = nothing outdated
            if os.path.exists(BREW):
                env = dict(os.environ, HOMEBREW_NO_AUTO_UPDATE="1")
                try:
                    res = subprocess.run(
                        [BREW, "outdated", "--quiet"],
                        text=True, capture_output=True, timeout=90, env=env,
                    )
                    brew_list = [x.strip() for x in res.stdout.splitlines() if x.strip()]
                except (OSError, subprocess.TimeoutExpired):
                    brew_list = None
            GLib.idle_add(self._set_counts, flat_list, brew_list)

        GLib.Thread.new(None, worker)

    def _set_counts(self, flat_list, brew_list):
        self._flatpak_updates = flat_list
        self._brew_updates = brew_list

        def phrase(items, noun):
            if items is None:
                return "Unavailable"
            if not items:
                return f"All {noun} are up to date"
            preview = ", ".join(items[:2])
            if len(items) > 2:
                preview += f" and {len(items) - 2} more"
            return f"{len(items)} waiting: {preview}"

        self._flatpak_row.set_subtitle(phrase(flat_list, "apps"))
        self._flatpak_row.set_activatable(bool(flat_list))
        self._brew_row.set_subtitle(phrase(brew_list, "tools"))
        self._brew_row.set_activatable(bool(brew_list))
        self._brew_button.set_visible(bool(brew_list))
        return False

    def _list_dialog(self, title, description, items, empty):
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(title=title, description=description)
        page.add(group)
        if items:
            for item in items:
                row = Adw.ActionRow(title=item)
                row.add_prefix(Gtk.Image.new_from_icon_name("package-x-generic-symbolic"))
                group.add(row)
        else:
            row = Adw.ActionRow(title=empty)
            group.add(row)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(page)
        dialog = Adw.Dialog()
        dialog.set_title(title)
        dialog.set_content_width(460)
        dialog.set_content_height(520)
        dialog.set_child(toolbar)
        dialog.present(self)

    def _on_show_layered(self, _row):
        self._list_dialog(
            "Extra Packages",
            "Installed on top of the image (rpm-ostree layering), usually by "
            "ujust margine-gaming-native. They are re-resolved from the "
            "repositories on every system update, so they stay current with it.",
            self._state.get("layered") or [],
            "No extra packages",
        )

    def _on_show_flatpak(self, _row):
        self._list_dialog(
            "App Updates",
            "Flatpak apps with an update waiting. These install automatically "
            "in the background; nothing to do.",
            getattr(self, "_flatpak_updates", None) or [],
            "All apps are up to date",
        )

    def _on_show_brew(self, _row):
        self._list_dialog(
            "Command-line Tools",
            "Homebrew packages with a newer version available. They upgrade "
            "weekly on their own; Update Now does it immediately.",
            getattr(self, "_brew_updates", None) or [],
            "All tools are up to date",
        )

    def _on_brew_update(self, _button):
        # No pkexec here on purpose: brew's prefix belongs to the user
        # and brew refuses to run as root.
        self._brew_button.set_sensitive(False)
        self._run_command(
            ["/usr/libexec/margine/brew-upgrade"],
            title="Updating Command-line Tools",
            done="Command-line tools updated",
        )

    # ── actions ──────────────────────────────────────────────────────

    def _on_primary_action(self, _button):
        if self._state.get("staged"):
            self._reboot()
        elif self._latest and self._state.get("booted") != self._latest:
            self._run_command(
                ["pkexec", SYSTEM_UPDATE],
                title="Downloading Update",
                done="Update downloaded — restart to apply it",
            )
        else:
            self._latest = None
            self._latest_digest = ""
            self._refresh()

    def _reboot(self):
        dialog = Adw.AlertDialog(
            heading="Restart Now?",
            body="Open apps will be closed. The update is applied while restarting.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("restart", "Restart")
        dialog.set_response_appearance("restart", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel")
        dialog.connect("response", self._on_reboot_response)
        dialog.present(self)

    def _on_reboot_response(self, _dialog, response):
        if response == "restart":
            subprocess.Popen(["systemctl", "reboot"])

    def _on_rollback(self, _button):
        target = self._state.get("rollback") or "the previous version"
        dialog = Adw.AlertDialog(
            heading="Roll Back?",
            body=(
                f"The next restart will boot {target} instead of the current version. "
                "Your files and settings are not touched, and you can roll forward again "
                "by updating."
            ),
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("rollback", "Roll Back")
        dialog.set_response_appearance("rollback", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.connect(
            "response",
            lambda _d, r: r == "rollback" and self._run_command(
                ["pkexec", "/usr/bin/rpm-ostree", "rollback"],
                title="Rolling Back",
                done="Rolled back — restart to boot the previous version",
            ),
        )
        dialog.present(self)

    def _on_run_check(self, _button):
        self._check_button.set_sensitive(False)
        self._check_button.set_label("Running…")

        def worker():
            results = []
            validators = sorted(
                p for p in os.listdir("/usr/bin") if p.startswith("margine-validate-")
            )
            for path in validators:
                try:
                    res = subprocess.run(
                        [f"/usr/bin/{path}"], text=True, capture_output=True, timeout=180
                    )
                    ok = res.returncode == 0
                    detail = (res.stdout + res.stderr).strip()
                except (OSError, subprocess.TimeoutExpired):
                    ok, detail = False, "the check did not finish"
                nice = path.replace("margine-validate-", "").replace("-", " ").capitalize()
                results.append((nice, ok, detail))
            GLib.idle_add(self._show_check_results, results)

        GLib.Thread.new(None, worker)

    def _show_check_results(self, results):
        self._check_button.set_sensitive(True)
        self._check_button.set_label("Run")
        if not results:
            self._toast("No checks are installed on this system")
            return False

        failed = [r for r in results if not r[1]]
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(
            title="System Check",
            description=(
                "Everything matches how Margine ships."
                if not failed
                else f"{len(failed)} of {len(results)} checks need attention."
            ),
        )
        page.add(group)
        for name, ok, detail in results:
            row = Adw.ActionRow(title=name)
            row.add_prefix(
                Gtk.Image.new_from_icon_name(
                    "object-select-symbolic" if ok else "dialog-warning-symbolic"
                )
            )
            if not ok and detail:
                row.set_subtitle(detail.splitlines()[-1][:160])
                row.set_subtitle_lines(3)
            group.add(row)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(page)
        dialog = Adw.Dialog()
        dialog.set_title("System Check")
        dialog.set_content_width(520)
        dialog.set_content_height(560)
        dialog.set_child(toolbar)
        dialog.present(self)
        return False

    # ── privileged runner with live output ───────────────────────────

    def _run_command(self, argv, title, done):
        if self._busy:
            return
        self._busy = True
        self._action_button.set_sensitive(False)

        buffer = Gtk.TextBuffer()
        view = Gtk.TextView(buffer=buffer, editable=False, monospace=True)
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scroller = Gtk.ScrolledWindow(child=view, vexpand=True)
        scroller.set_min_content_height(320)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(scroller)
        dialog = Adw.Dialog()
        dialog.set_title(title)
        dialog.set_content_width(620)
        dialog.set_content_height(420)
        dialog.set_child(toolbar)
        dialog.set_can_close(False)
        dialog.present(self)

        try:
            proc = Gio.Subprocess.new(
                argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
            )
        except GLib.Error as e:
            self._busy = False
            self._action_button.set_sensitive(True)
            dialog.set_can_close(True)
            dialog.close()
            self._toast(f"Could not start: {e.message}")
            return

        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        self._read_line(stream, buffer, view)
        proc.wait_async(None, self._on_privileged_done, (dialog, done))

    def _read_line(self, stream, buffer, view):
        def on_line(src, result):
            try:
                line, _ = src.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                return
            buffer.insert(buffer.get_end_iter(), line + "\n")
            view.scroll_to_mark(
                buffer.create_mark(None, buffer.get_end_iter(), False), 0, False, 0, 0
            )
            self._read_line(src, buffer, view)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    def _on_privileged_done(self, proc, result, payload):
        dialog, done_message = payload
        self._busy = False
        self._action_button.set_sensitive(True)
        self._brew_button.set_sensitive(True)
        try:
            proc.wait_finish(result)
            ok = proc.get_if_exited() and proc.get_exit_status() == 0
        except GLib.Error:
            ok = False
        dialog.set_can_close(True)
        if ok:
            dialog.close()
            self._toast(done_message)
        else:
            # Leave the log on screen: a failed update is exactly when
            # the output matters. pkexec exits 126/127 when the user
            # dismissed the password prompt — not worth a scary toast.
            self._toast("The operation did not complete — see the log")
        self._refresh()

    def _on_about(self, *_args):
        about = Adw.AboutDialog(
            application_name="Margine System",
            application_icon=APP_ID,
            developer_name="Daniel Grasso",
            website="https://margine.dev/docs/updates-and-rollback",
            issue_url="https://github.com/daniel-g-carrasco/margine-image/issues",
            license_type=Gtk.License.GPL_3_0,
        )
        status = run(["/usr/bin/margine-status"], timeout=90)
        if status:
            about.set_debug_info(status)
            about.set_debug_info_filename("margine-status.txt")
        about.present(self)


class SystemApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        if not self.get_active_window():
            SystemWindow(self)
        self.get_active_window().present()


def main():
    if not shutil.which("rpm-ostree"):
        print("margine-system-gui: this is not an rpm-ostree/bootc system", flush=True)
    return SystemApp().run(None)


if __name__ == "__main__":
    raise SystemExit(main())
