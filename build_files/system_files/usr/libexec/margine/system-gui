        # to BE a whole view, and nested in a PreferencesGroup it drew
        # its icon while swallowing title and description entirely
        # (first user test: "non è chiaro a colpo d'occhio se il sistema
        # è aggiornato"). A plain box renders predictably and lets the
        # version sit right under the verdict, which is the one thing
        # people open this app to learn.
        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        hero.set_margin_top(12)
        hero.set_margin_bottom(18)

