#!/usr/bin/env bash
# Margine: keep the Homebrew CLI channel current.
#
# WHY THIS EXISTS (2026-08-09). Homebrew lives in the user's home, not
# in the image, so image updates never touch it. uupd owns that job in
# theory: its Brew module runs `brew update` and then `brew upgrade -y`.
# In practice only the first half works here, because uupd (a system
# service running as root) shells out to the user through pkexec, which
# has no authentication agent in that context and is refused. Observed
# every single night on the reference host:
#
#   09:32:29  ==> Updating Homebrew...      <- brew update, 4s, fine
#   09:32:29  Updated 1 tap (homebrew/cask).
#   09:32:30  Flatpak module...             <- upgrade gone in 0.4s, silent
#
# Net effect: `brew update` refreshed the catalog forever while nothing
# was ever upgraded — 13 stale packages, one of them a linter two minor
# versions behind what CI used. Running the upgrade from the USER's own
# systemd instance sidesteps the privilege dance entirely: no pkexec,
# no root, just the owner of the prefix doing its own maintenance.
#
# Deliberately quiet: this is background hygiene, not an event. It only
# speaks up (one desktop notification) when packages actually moved, so
# the user can correlate "my CLI behaves differently today" with a fact.
set -euo pipefail

BREW=/home/linuxbrew/.linuxbrew/bin/brew
[[ -x "$BREW" ]] || exit 0

# Homebrew's own auto-update would fire an implicit `brew update` on
# every invocation; we do it once, explicitly, and want the upgrade to
# use exactly that catalog.
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_ANALYTICS=1

log() { printf '%s\n' "$*"; }

log "Updating the Homebrew catalog"
"$BREW" update || log "catalog update failed (transient network?) — continuing with the cached catalog"

mapfile -t OUTDATED < <("$BREW" outdated --quiet 2>/dev/null || true)
if [[ ${#OUTDATED[@]} -eq 0 ]]; then
  log "Nothing to upgrade."
  exit 0
fi
log "Upgrading ${#OUTDATED[@]} package(s): ${OUTDATED[*]}"

if ! "$BREW" upgrade; then
  log "brew upgrade reported errors — see the output above"
  exit 1
fi

# `brew cleanup` reclaims the old kegs; without it the Cellar grows by
# a full copy of every upgraded package, forever.
"$BREW" cleanup --prune=30 || true

MN=/usr/libexec/margine/margine-notify
if [[ -x "$MN" ]]; then
  count=${#OUTDATED[@]}
  if (( count == 1 )); then
    body="${OUTDATED[0]} was updated."
  else
    body="${count} command-line tools were updated, including ${OUTDATED[0]}."
  fi
  "$MN" -u low "Command-line tools updated" "$body" || true
fi
log "Done."
