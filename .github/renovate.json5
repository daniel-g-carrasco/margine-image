{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  rebaseWhen: 'never',
  packageRules: [
    {
      matchDepNames: [
        'ublue-os/titanoboa',
        'daniel-g-carrasco/titanoboa',
      ],
      enabled: false,
    },
    {
      // Auto-merge everything non-major once checks are green (2026-08-09,
      // Daniel's request). Mechanics: platformAutomerge (Renovate default)
      // arms GitHub's native auto-merge on the PR; branch protection
      // requires the `lint` check, so a red PR can never slip through,
      // and the pin-sync workflows (wsf/otiling fix-sha) pushing to the
      // branch simply re-arm the wait on the new SHA. Major updates stay
      // manual by design: they are the ones that break rebases and APIs.
      automerge: true,
      // Renovate-side automerge (NOT GitHub's platform auto-merge):
      // platform auto-merge waits only for REQUIRED checks (lint), while
      // Renovate itself merges only when EVERY check on the PR is green,
      // including the non-required full image build that the vm-test
      // label triggers on baked-dependency bumps. That full build (with
      // the in-container validators) is the actual compatibility gate.
      platformAutomerge: false,
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'pinDigest',
        'digest',
      ],
    },
    {
      // Anything baked into the image must prove it BUILDS before it
      // merges: the vm-test label makes build.yml run the full 30-min
      // image build (validators included) on the PR.
      matchFileNames: [
        'build_files/**',
        'Containerfile',
      ],
      addLabels: [
        'vm-test',
      ],
    },
    {
      enabled: false,
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
      matchDepTypes: [
        'container',
      ],
      matchFileNames: [
        '.github/workflows/**.yaml',
        '.github/workflows/**.yml',
      ],
    },
    {
      // Containerfile base images (bluefin-dx, bluefin, bazzite, our own
      // margine) track the rolling :stable tag BY DESIGN — Margine rebuilds on
      // the upstream :stable cadence and stamps base.digest itself. Never let
      // Renovate pin them to a digest: it freezes nothing useful and produced a
      // recurring "pin dependencies" branch-update failure on the dashboard.
      // Tag/version bumps stay enabled; only pin/pinDigest/digest are off.
      enabled: false,
      matchManagers: [
        'dockerfile',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/build_files/45-wsf/install\\.sh$/',
      ],
      matchStrings: [
        'WSF_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'daniel-g-carrasco/wayland-scroll-factor',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      // o-tiling (default tiler) is a sha256-pinned GitHub release. Renovate
      // proposes the OTILING_VERSION bump; the companion workflow
      // .github/workflows/otiling-pin-sha.yml recomputes OTILING_SHA256 on
      // the Renovate branch (hosted Renovate can't hash a release zip).
      // Added 2026-06-14 after o-tiling sat at 2.8.8 through the 2.8.11
      // GNOME-50 toggle-reentrancy fix (oliwebd/o-tiling#15) — nothing was
      // watching this pin.
      customType: 'regex',
      managerFilePatterns: ['/build_files/build-margine-extensions\\.sh$/'],
      matchStrings: ['OTILING_VERSION="(?<currentValue>v\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: 'oliwebd/o-tiling',
      datasourceTemplate: 'github-releases',
    },
    {
      // scrcpy (Phone Camera engine), pinned release tarball in
      // 70-phone-cam. Same sha-companion pattern: renovate bumps
      // SCRCPY_VERSION, .github/workflows/scrcpy-pin-sha.yml recomputes
      // SCRCPY_SHA256 on the branch.
      customType: 'regex',
      managerFilePatterns: ['/build_files/70-phone-cam/install\\.sh$/'],
      matchStrings: ['SCRCPY_VERSION=(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)'],
      depNameTemplate: 'Genymobile/scrcpy',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
  ],
}
