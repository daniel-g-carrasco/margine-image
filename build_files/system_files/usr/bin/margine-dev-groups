#!/usr/bin/env bash
# Put every wheel member in the libvirt group, and in the docker and
# incus-admin groups when those exist (after `ujust margine-docker`, or incus
# layered by hand). Runs at every boot (build_files/15-devstack enables it):
# a group can appear later, and usermod -aG on a member is a no-op.
# Margine's stand-in for Bluefin DX's bluefin-dx-groups, which expects the
# docker and incus-admin groups and restarts every 30 s when they are gone.
set -u
# Groups defined by packages live in /usr/lib/group on an ostree system;
# copy the entry into /etc/group so usermod can find it.
for g in docker incus-admin libvirt; do
  grep -q "^$g:" /etc/group || grep "^$g:" /usr/lib/group >>/etc/group 2>/dev/null || true
done
for u in $(getent group wheel | cut -d: -f4 | tr ',' ' '); do
  for g in docker incus-admin libvirt; do
    getent group "$g" >/dev/null 2>&1 || continue
    usermod -aG "$g" "$u" 2>/dev/null || true
  done
done
