// Generated by Noctalia from the active palette, with Lucciola's template
// (/usr/share/lucciola/noctalia/templates/niri.kdl); rewritten on every theme
// change. Same colours as Noctalia's built-in niri template (focused border
// in the primary colour, unfocused ones in the bar background, so only the
// focused window stands out), but delivered through the system niri config
// instead of an include in ~/.config/niri/config.kdl. Do not edit: own
// colours go in ~/.config/niri/lucciola.kdl.
layout {
    focus-ring {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.surface.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    border {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.surface.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    tab-indicator {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.primary_container.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
