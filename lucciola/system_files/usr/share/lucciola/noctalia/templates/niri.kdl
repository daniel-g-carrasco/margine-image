// Generated by Noctalia from the active palette, with Lucciola's template
// (/usr/share/lucciola/noctalia/templates/niri.kdl); rewritten on every theme
// change. Unlike Noctalia's built-in niri template, unfocused borders use
// outline_variant (#3b3b3f with the Margine palette), not surface (the bar
// background), so they stay visible. Do not edit: own colours go in
// ~/.config/niri/lucciola.kdl.
layout {
    focus-ring {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline_variant.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    border {
        active-color   "{{colors.on_surface.default.hex}}e0"
        inactive-color "{{colors.outline_variant.default.hex}}cc"
        urgent-color   "{{colors.error.default.hex}}"
    }

    tab-indicator {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline_variant.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
