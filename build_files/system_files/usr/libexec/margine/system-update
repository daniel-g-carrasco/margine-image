#!/usr/bin/env bash
# Margine: stage the latest :stable, non-interactively.
#
# ONE implementation of the update decision, shared by `ujust
# margine-update` (which wraps it with the status header) and the
# Margine System app (which runs it through pkexec and streams the
# output into its window). Before this existed the logic lived only in
# the just recipe, so the GUI would have had to duplicate it — and the
# duplicate would have drifted the first time the rules changed.
#
# The decision itself is load-bearing and easy to get wrong: `bootc
# upgrade` REFUSES a client-layered deployment ("Deployment contains
# local rpm-ostree modifications"), which is the normal state after
# `ujust margine-gaming-native`. So the question is never "is bootc
# available" (it always is on a bootc image) but "are there layered
# packages": if yes, rpm-ostree upgrade, which pulls the new base AND
# re-applies the layers.
#
# Must run as root (the caller supplies privilege: sudo from the
# recipe, pkexec from the app).
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "This must run as root (via sudo or pkexec)." >&2
  exit 1
fi

# pkexec hands over a minimal environment; be explicit rather than
# inheriting whatever the caller had.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

if rpm-ostree status 2>/dev/null | grep -qE '^[[:space:]]*(Layered|Local)Packages:'; then
  echo "Layered packages detected (e.g. gaming-native) — using rpm-ostree upgrade."
  echo "(bootc upgrade refuses client-layered deployments; rpm-ostree re-applies your layers.)"
  rpm-ostree upgrade
elif command -v bootc >/dev/null 2>&1; then
  echo "No local layers — using bootc upgrade."
  bootc upgrade
else
  echo "Staging the latest Margine :stable (rpm-ostree upgrade)."
  rpm-ostree upgrade
fi

echo
echo "Done. Reboot to switch into the new deployment."
